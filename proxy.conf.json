{
  "_comment": "Proxy de dev: redireciona /api/auth/* pro auth-service (8001) e /api/account/* pro account-service (8000). Evita CORS em desenvolvimento.",

  "/api/auth": {
    "target": "http://localhost:8001",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "debug",
    "pathRewrite": {
      "^/api": ""
    }
  },

  "/api/account": {
    "target": "http://localhost:8000",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "debug",
    "pathRewrite": {
      "^/api": ""
    }
  }
}
